<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chess Master - Realtime Multiplayer</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&family=Space+Mono:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-cream: #e6ddc6;
      --bg-card: #f3edd9;
      --terracotta: #c85b3c;
      --terracotta-dark: #b04c30;
      --dark-charcoal: #1c1a17;
      --square-light: #eae2cf;
      --square-dark: #82422e;
      --font-serif: 'Playfair Display', serif;
      --font-mono: 'Space Mono', monospace;
      --font-sans: 'Inter', sans-serif;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--bg-cream);
      color: var(--dark-charcoal);
    }

    .font-serif-title {
      font-family: var(--font-serif);
      font-weight: 900;
    }

    .font-mono-sub {
      font-family: var(--font-mono);
    }

    /* ── Chessboard ── */
    .chessboard {
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-template-rows: repeat(8, minmax(0, 1fr));
      width: 480px;
      height: 480px;
      border-radius: 12px;
      overflow: hidden;
      user-select: none;
      transition: transform 0.4s ease-in-out;
      border: 4px solid var(--dark-charcoal);
      box-shadow: 0 16px 32px rgba(28, 26, 23, 0.25);
    }

    @media (max-width: 640px) {
      .chessboard { width: 340px; height: 340px; }
    }

    .square {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      font-size: 2.75rem;
    }

    @media (max-width: 640px) {
      .square { font-size: 2rem; }
    }

    .square.light { background-color: var(--square-light); }
    .square.dark  { background-color: var(--square-dark); }

    .square.selected { background-color: #d69852 !important; }

    .square.in-check {
      background: repeating-linear-gradient(
        45deg, #d32f2f, #d32f2f 4px, #b71c1c 4px, #b71c1c 8px
      ) !important;
      animation: pulseCheck 0.8s infinite alternate;
    }

    @keyframes pulseCheck {
      from { opacity: 0.85; }
      to   { opacity: 1; }
    }

    .piece {
      cursor: pointer;
      z-index: 10;
      transition: transform 0.1s ease;
      line-height: 1;
    }

    .piece.draggable { cursor: grab; }

    .piece.white {
      color: #ffffff;
      filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.8));
    }

    .piece.black {
      color: #12100e;
      filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.9)) drop-shadow(0 1px 2px rgba(255, 255, 255, 0.6));
    }

    .flipped { transform: rotate(180deg); }
    .flipped .piece { transform: rotate(180deg); }

    .shake {
      animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
    }

    @keyframes shake {
      10%, 90% { transform: translate3d(-1px, 0, 0); }
      20%, 80% { transform: translate3d(2px, 0, 0); }
      30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
      40%, 60% { transform: translate3d(4px, 0, 0); }
    }

    /* ── Scrollbar ── */
    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: #dfd5be; }
    ::-webkit-scrollbar-thumb { background: #b8aa8e; border-radius: 3px; }

    /* ── Buttons ── */
    .btn-terracotta {
      background-color: var(--terracotta);
      color: #ffffff;
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 12px 24px;
      border-radius: 8px;
      border: 2px solid var(--terracotta);
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 4px 12px rgba(200, 91, 60, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
    .btn-terracotta:hover {
      background-color: var(--terracotta-dark);
      border-color: var(--terracotta-dark);
      transform: translateY(-1px);
    }

    .btn-outline-terracotta {
      background-color: transparent;
      color: var(--dark-charcoal);
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 12px 24px;
      border-radius: 8px;
      border: 2px solid var(--dark-charcoal);
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
    .btn-outline-terracotta:hover {
      background-color: var(--dark-charcoal);
      color: #ffffff;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between" style="background-color: var(--bg-cream);">

  <!-- ═══ Navigation Header ═══ -->
  <header class="w-full px-8 py-4 flex items-center justify-between border-b border-[#d8cdb3]">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-black text-[#e6ddc6] rounded-md flex items-center justify-center font-bold text-xl shadow">
        <i class="fa-solid fa-chess-knight"></i>
      </div>
      <div>
        <h1 class="font-serif-title text-xl tracking-wider text-[#1c1a17]">CHESS MASTER</h1>
      </div>
    </div>

    <!-- Turn & Role Badges -->
    <div class="flex items-center gap-3">
      <div id="turnBanner" class="flex items-center gap-2.5 px-4 py-2 rounded-full border-2 border-[#c85b3c] text-xs font-mono-sub font-bold tracking-wider text-[#c85b3c] bg-[#f3edd9]">
        <span class="w-2.5 h-2.5 rounded-full bg-[#c85b3c] animate-pulse" id="turnDot"></span>
        <span id="turnText">WHITE TO MOVE</span>
      </div>

      <div id="roleBadge" class="flex items-center gap-2 text-xs font-mono-sub font-bold tracking-wider px-4 py-2 rounded-full bg-[#c85b3c] text-white shadow">
        <i class="fa-solid fa-user"></i>
        <span id="roleText">CONNECTING...</span>
      </div>
    </div>
  </header>

  <!-- ═══ Main Game Arena ═══ -->
  <main class="flex-1 flex flex-col md:flex-row items-center justify-center p-6 gap-8 max-w-7xl mx-auto w-full">

    <!-- Left: Board Section -->
    <div class="flex flex-col items-center gap-3">

      <!-- Top Player Card (Opponent) -->
      <div class="w-[480px] max-w-full bg-[#f3edd9] border-2 border-[#1c1a17] rounded-xl p-3 flex items-center justify-between shadow">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-[#1c1a17] text-[#e6ddc6] flex items-center justify-center text-sm font-bold shadow" id="topAvatar">
            <i class="fa-solid fa-chess-king"></i>
          </div>
          <div>
            <div class="font-mono-sub font-bold text-sm flex items-center gap-2 text-[#1c1a17]" id="topPlayerName">
              OPPONENT
              <span class="w-2.5 h-2.5 rounded-full bg-gray-400" id="topOnlineDot"></span>
            </div>
            <span class="font-mono-sub text-[11px] text-[#7c705a] font-bold" id="topRoleText">BLACK</span>
          </div>
        </div>
        <div class="flex items-center gap-1 text-lg" id="topCaptured"></div>
      </div>

      <!-- Chessboard -->
      <div class="relative">
        <div id="chessboard" class="chessboard"></div>
      </div>

      <!-- Bottom Player Card (You) -->
      <div class="w-[480px] max-w-full bg-[#f3edd9] border-2 border-[#1c1a17] rounded-xl p-3 flex items-center justify-between shadow">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-[#c85b3c] text-white flex items-center justify-center text-sm font-bold shadow" id="bottomAvatar">
            <i class="fa-solid fa-user"></i>
          </div>
          <div>
            <div class="font-mono-sub font-bold text-sm flex items-center gap-2 text-[#1c1a17]" id="bottomPlayerName">
              YOU
              <span class="w-2.5 h-2.5 rounded-full bg-green-600" id="bottomOnlineDot"></span>
            </div>
            <span class="font-mono-sub text-[11px] text-[#7c705a] font-bold" id="bottomRoleText">WHITE</span>
          </div>
        </div>
        <div class="flex items-center gap-1 text-lg" id="bottomCaptured"></div>
      </div>

    </div>

    <!-- Right: Sidebar Panel -->
    <div class="w-full md:w-84 bg-[#f3edd9] border-2 border-[#1c1a17] rounded-2xl flex flex-col justify-between h-[560px] shadow-lg overflow-hidden">

      <!-- Panel Header -->
      <div class="bg-[#c85b3c] text-white px-5 py-3.5 flex items-center justify-between">
        <h3 class="font-serif-title text-xl tracking-wider">MOVE HISTORY</h3>
        <span class="font-mono-sub text-xs text-white/90 font-bold" id="moveCount">0 MOVES</span>
      </div>

      <!-- Moves List -->
      <div class="flex-1 overflow-y-auto px-4 py-3 flex flex-col gap-1 text-sm bg-[#f8f4e8]" id="moveHistoryList">
        <p class="font-mono-sub text-xs text-[#8c8069] text-center py-10 tracking-wider">Moves will appear here as you play...</p>
      </div>

      <!-- Actions -->
      <div class="p-4 border-t-2 border-[#1c1a17] bg-[#f3edd9] flex flex-col gap-3">
        <button id="restartBtn" class="btn-terracotta w-full">
          <i class="fa-solid fa-rotate-right"></i>
          RESTART GAME
          <span>→</span>
        </button>
      </div>
    </div>

  </main>

  <!-- ═══ Footer ═══ -->
  <footer class="bg-[#1c1a17] text-[#e6ddc6] px-8 py-4 flex flex-col sm:flex-row items-center justify-between text-xs font-mono-sub tracking-widest gap-2">
    <div class="flex items-center gap-3">
      <div class="w-3 h-3 rounded-full bg-[#c85b3c]"></div>
      <span class="font-bold">WEEKLY TOURNAMENTS & ONLINE MATCHES</span>
    </div>
    <span class="text-[#a89c84]">EVERY MOVE SHAPES YOUR MIND.</span>
  </footer>

  <!-- ═══ Toast Notification ═══ -->
  <div id="toast" class="fixed top-20 right-6 bg-[#c85b3c] text-white px-6 py-3.5 rounded-xl shadow-2xl text-sm font-mono-sub font-bold tracking-wider transition-all transform translate-y-[-100px] opacity-0 pointer-events-none z-50 flex items-center gap-3 border-2 border-[#1c1a17]">
    <i class="fa-solid fa-circle-exclamation text-lg"></i>
    <span id="toastMsg">ILLEGAL MOVE!</span>
  </div>

  <!-- ═══ Game Over Modal ═══ -->
  <div id="gameOverModal" class="fixed inset-0 bg-[#1c1a17]/80 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-[#f3edd9] border-3 border-[#1c1a17] rounded-3xl p-8 max-w-sm w-full text-center flex flex-col items-center gap-5 shadow-2xl" style="border-width: 3px;">
      <!-- Trophy icon -->
      <div class="w-20 h-20 rounded-2xl bg-[#c85b3c] text-white flex items-center justify-center text-4xl shadow-lg">
        <i class="fa-solid fa-trophy"></i>
      </div>
      <div>
        <h2 id="modalTitle" class="font-serif-title text-4xl text-[#1c1a17] mb-1 tracking-wide">GAME OVER</h2>
        <p id="modalReason" class="font-mono-sub text-xs text-[#6e634e] uppercase tracking-wider font-bold">White won by checkmate</p>
      </div>
      <button id="modalPlayAgainBtn" class="btn-terracotta w-full py-3.5 text-base">
        PLAY AGAIN
        <span>→</span>
      </button>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js" integrity="sha512-xRllwz2gdZciIB+AkEbeq+gVhX8VB8XsfqeFbUh+SzHlN96dEduwtTuVuc2u9EROlmW9+yhRlxjif66ORpsgVA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script src="/javascripts/chessgame.js"></script>
</body>
</html>